# --- JARVIS configuration ---
# Copy to .env and fill in real values. Never commit .env.
#
# This file is read by BOTH the BFF (server-side, via dotenv) and the Vite
# dev server (via envDir in vite.config.ts). Only variables prefixed with
# VITE_ are exposed to client code, so BFF-only secrets here are safe.
#
# Run `pnpm dev` from the workspace root — both processes pick this file up
# from the same location.

# Auth: bcrypt-hashed password used to mint the session JWT.
# Generate with: node -e "console.log(require('bcryptjs').hashSync('your-password', 10))"
JARVIS_PASSWORD=

# Secret used to sign the JWT cookie. Generate with: openssl rand -hex 32
JWT_SECRET=

# BFF port (architecture default: 3001)
PORT=3001

# Client Vite dev server origin (CORS + WebSocket upgrade)
CLIENT_ORIGIN=http://localhost:5174

# --- External APIs (server-side only) ---

# Deepgram: STT (WebSocket) + TTS (REST)
DEEPGRAM_API_KEY=
DEEPGRAM_SPEAK_MODEL=aura-zeus-en

# Open-Meteo weather API (no key required, but left here for future providers)
WEATHER_API_KEY=

# --- Agent (Hermes CLI subprocess) ---
# Hermes CLI binary. The BFF spawns `<HERMES_CMD> -p <HERMES_PROFILE>
# gateway run --accept-hooks` and proxies HTTP+SSE to the API server it
# starts on `HERMES_API_URL`. The `setup.sh` script installs the CLI.
HERMES_CMD=hermes
# Hermes profile name (the BFF will use `hermes -p <name> ...`).
HERMES_PROFILE=jarvis
# Base URL of the Hermes API server (loopback only).
HERMES_API_URL=http://127.0.0.1:8642
# Bearer token for the Hermes API server. Must be a 32-byte hex string
# (64 chars); generated by `scripts/setup.sh` and written to the profile's
# config.yaml `platforms.api_server.key` field.
HERMES_API_KEY=
# Health-poll cadence for the gateway readiness probe.
HERMES_HEALTH_POLL_MS=5000
# Deadline for the gateway to come up after spawn; on overrun the BFF
# SIGTERMs the subprocess and reschedules.
HERMES_HEALTH_DEADLINE_MS=15000
# Backoff applied when Hermes returns 401 (invalid key). After one retry
# at this delay, the spawner stops polling until the operator fixes the key.
HERMES_AUTH_BACKOFF_MS=30000

# --- Client-side env vars (Vite) ---
# Enable the openWakeWord wakeword listening service. The client uses
# the `openwakeword-wasm-browser` package (file: dependency in
# packages/client/package.json) and serves ONNX models + ORT WASM
# from packages/client/public/openwakeword/. The postinstall script
# (packages/client/scripts/copy-onnx-runtime.mjs) stages these from
# the installed packages. Re-run `pnpm --filter @jarvis/client
# postinstall` to re-sync if the onnxruntime-web or
# openwakeword-wasm-browser versions change.
# VITE_OPENWAKEWORD_ENABLED=true

# Auto-start wakeword listening when BFF + agent come online (default: true).
# VITE_WAKEWORD_AUTO_START=true

# Silence duration in ms after wakeword or push-to-talk before recording stops.
# Shared between wakeword VAD and STT push-to-talk VAD (default: 3000).
# VITE_WAKEWORD_SILENCE_MS=3000

# Wakeword keyword (one of: hey_jarvis, hey_mycroft, hey_rhasspy,
# alexa, timer, weather). Default: hey_jarvis. The matching .onnx file
# must be present in public/openwakeword/models/ (staged by postinstall).
# VITE_WAKEWORD_MODEL=hey_jarvis

# Detection confidence threshold (0..1, default: 0.5). Matches the
# openwakeword-wasm-browser reference; the engine layers VAD
# confirmation + a 2s cooldown on top of this score.
# VITE_WAKEWORD_THRESHOLD=0.5

# URL prefix where the ONNX models are served. Must match the
# public/openwakeword/models/ path that postinstall populates.
# VITE_WAKEWORD_BASE_URL=/openwakeword/models

# URL prefix where onnxruntime-web loads its WASM from. Must match
# the public/openwakeword/ort/ path that postinstall populates.
# Self-hosted because the dev server sets COEP=require-corp.
# VITE_WAKEWORD_ORT_PATH=/openwakeword/ort/
